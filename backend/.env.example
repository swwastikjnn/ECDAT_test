# MongoDB Atlas connection string
# Get this from MongoDB Atlas Dashboard > Connect > Drivers > Copy connection string
# Replace USERNAME, PASSWORD, and cluster with your actual values
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ecdat

# Python scanner service URL
# For local dev: http://localhost:8000
# For Render: https://your-scanner.onrender.com
SCANNER_URL=http://localhost:8000

# Backend server port
# Render sets this automatically; locally defaults to 3000
PORT=3000